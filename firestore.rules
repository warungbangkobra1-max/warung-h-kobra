rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64;
    }

    function isValidOrder(data) {
      return data.id_transaksi is string &&
        data.id_transaksi.size() > 0 &&
        data.id_transaksi.size() <= 64 &&
        data.nama_pelanggan is string &&
        data.nama_pelanggan.size() > 0 &&
        data.nama_pelanggan.size() <= 100 &&
        data.total is number &&
        data.total >= 0 &&
        data.status in ['Pending', 'Diproses', 'Selesai', 'Dibatalkan'] &&
        data.metode_pembayaran is string &&
        data.created_at is string;
    }

    // Orders collection: Customer creates order without app install via mobile browser
    match /orders/{orderId} {
      allow read: if true;
      allow create: if isValidId(orderId) && isValidOrder(request.resource.data);
      allow update: if isValidId(orderId) && request.resource.data.status in ['Pending', 'Diproses', 'Selesai', 'Dibatalkan'];
      allow delete: if true;
    }

    // Products collection: Readable by public customers browsing menu, writable by warung
    match /products/{productId} {
      allow read: if true;
      allow write: if isValidId(productId);
    }
  }
}
